# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Documents the variables, holds no secrets.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# local user data (reflections & notes)
data/reflections/
data/notes/



# Raw model-screening output (temp/ai-eval). Large and regenerable by re-running
# the harness; the failure cases worth keeping are already Vitest fixtures in
# lib/__tests__/aiValidate.test.ts.
temp/ai-eval/results/

# Database backups hold personal data (npm run db:backup).
/backups/

# The Expo app (mobile/) keeps its own dependencies and build output.
mobile/node_modules
mobile/.expo
mobile/dist
mobile/android
mobile/ios
mobile/*.log
