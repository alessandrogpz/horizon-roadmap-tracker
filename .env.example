# What .env.local holds. No need to copy this file: `npm run db:up` writes the
# values into .env.local, with freshly generated passwords, the first time it
# runs. The database's own passwords go into .env.docker, which only the
# database containers read. Neither file is ever committed.

# The app's connection to MongoDB, as the horizon_app user (readWrite on the
# horizon database only). Listing all three members and the replica set name
# lets the driver find the primary and follow it through a failover.
# Deployed: the Atlas connection string, set in Vercel's environment variables.
MONGODB_URI=mongodb://horizon_app:<password>@localhost:27017,localhost:27018,localhost:27019/horizon?replicaSet=rs0&authSource=admin

# The same for `npm run test:db`, as horizon_test on its own database.
MONGODB_TEST_URI=mongodb://horizon_test:<password>@localhost:27017,localhost:27018,localhost:27019/horizon_test?replicaSet=rs0&authSource=admin

# Horizon's Google OAuth client ID, for "Sign in with Google". Public by
# design: every visitor's browser sees it, and Google only accepts it from the
# origins listed for it (localhost and https://horizonroadmap.com). Leave it
# out and the app hides sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=82064719586-e6s5ajaef0qrun4g7j3667mii5etojm5.apps.googleusercontent.com
