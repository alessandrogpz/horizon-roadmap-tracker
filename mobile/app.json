{
  "expo": {
    "name": "Horizon",
    "slug": "horizon",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "horizon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.horizonroadmap.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sensors",
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "alessandrogpz",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0ab92496-485f-448d-9a02-322290450ff7"
      },
      "serverUrl": "https://horizonroadmap.com",
      "googleClientId": "82064719586-e6s5ajaef0qrun4g7j3667mii5etojm5.apps.googleusercontent.com"
    },
    "updates": {
      "url": "https://u.expo.dev/0ab92496-485f-448d-9a02-322290450ff7"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
