{
  "name": "horizon-roadmap-tracker",
  "version": "0.19.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:up": "node scripts/dev-env.mjs && docker compose up -d && docker compose wait init",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes",
    "db:shell": "docker compose exec mongo1 mongosh 'mongodb://localhost:27017,localhost:27018,localhost:27019/horizon?replicaSet=rs0&authSource=admin' -u horizon_app"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.26.0",
    "mongoose": "^9.9.5",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
