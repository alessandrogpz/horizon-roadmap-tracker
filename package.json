{
  "name": "horizon-roadmap-tracker",
  "version": "0.66.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:up": "node scripts/dev-env.mjs && docker compose up -d && docker compose wait init",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes",
    "db:backup": "tsx scripts/backup.ts",
    "ops:check": "tsx scripts/ops-check.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:explain": "tsx scripts/explain.ts",
    "demo:failover": "tsx scripts/failover.ts",
    "db:shell": "docker compose exec mongo1 mongosh 'mongodb://localhost:27017,localhost:27018,localhost:27019/horizon?replicaSet=rs0&authSource=admin' -u horizon_app"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.26.0",
    "mongoose": "^9.9.5",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
