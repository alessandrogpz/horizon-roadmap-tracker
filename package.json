{
  "name": "horizon-roadmap-tracker",
  "version": "0.119.7",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:up": "node scripts/dev-env.mjs && docker compose up -d && docker compose wait init",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes",
    "db:backup": "tsx scripts/backup.ts",
    "ops:check": "tsx scripts/ops-check.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:explain": "tsx scripts/explain.ts",
    "demo:failover": "tsx scripts/failover.ts",
    "db:shell": "docker compose exec mongo1 mongosh 'mongodb://localhost:27017,localhost:27018,localhost:27019/horizon?replicaSet=rs0&authSource=admin' -u horizon_app"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "mongoose": "^9.12.2",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
